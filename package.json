{
  "name": "sparklet",
  "version": "0.2.2",
  "description": "Sparklet",
  "internalCodename": "Vapor",
  "main": "./src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "generate-manifest": "node scripts/generate-manifest.js"
  },
  "keywords": [
    "notes",
    "desktop",
    "toolbox"
  ],
  "author": "TRR-a",
  "license": "MIT",
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fs-extra": "^11.4.0",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.github.trra.sparklet.base.studio",
    "productName": "Sparklet",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icons/icon256.ico"
    }
  }
}
