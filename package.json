{
  "name": "sparklet",
  "version": "0.2.2",
  "description": "Sparklet",
  "internalCodename": "Vapor",
  "main": "./src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "generate-manifest": "node scripts/generate-manifest.js",
    "prepare": "husky",
    "lint": "echo \"No linter configured yet\""
  },
  "keywords": [
    "notes",
    "desktop",
    "toolbox"
  ],
  "author": "TRR-a",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "electron": "40.0.0",
    "electron-builder": "^24.6.4",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fs-extra": "^11.4.0",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.github.trra.sparklet.base.studio",
    "productName": "Sparklet",
    "directories": {
      "output": "release/v0.2.2"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/updater.js",
        "to": "updater.js"
      }
    ],
    "win": {
      "icon": "assets/icons/icon256.ico",
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    }
  }
}
