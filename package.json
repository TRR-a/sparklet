{
  "name": "sparklet",
  "version": "0.2.3",
  "description": "Sparklet",
  "internalCodename": "Mist",
  "main": "./src/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "tsc -p tsconfig.renderer.json --watch",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "generate-manifest": "npm run build:main && node scripts/generate-manifest.js",
    "prepare": "husky",
    "lint": "echo \"No linter configured yet\""
  },
  "keywords": [
    "notes",
    "desktop",
    "toolbox"
  ],
  "author": "TRR-a",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.0.0",
    "@types/unzipper": "^0.10.9",
    "electron": "40.0.0",
    "electron-builder": "^24.6.4",
    "husky": "^9.1.7",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fs-extra": "^11.4.0",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.github.trra.sparklet.base.studio",
    "productName": "Sparklet",
    "directories": {
      "output": "release/v0.2.3"
    },
    "files": [
      "src/**/*",
      "!src/**/*.ts",
      "!src/**/*.js.map",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/updater.js",
        "to": "updater.js"
      }
    ],
    "win": {
      "icon": "assets/icons/icon256.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron@40.0.0": true
  }
}
