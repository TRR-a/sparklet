# Dependencies [依赖目录]
node_modules/

# Compiled TypeScript output in src/ (keep scripts/ and resources/ as JS) [src/ 下的编译输出 (scripts/ 和 resources/ 保持 JS)]
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# Compiled output in modules/ [modules/ 下的编译输出]
modules/**/*.js
modules/**/*.js.map
modules/**/*.d.ts

# Exception: hand-written vendor type declarations (bundles emit to build/) [例外：手写 vendor 类型声明 (bundle 本体输出到 build/)]
!src/renderer/vendor/*.d.ts
!modules/**/vendor/*.bundle.d.ts

# Exception: hand-written global type declarations [例外：手写的全局类型声明]
!modules/note/Base/global.d.ts

# Build output directories [构建输出目录]
release/
dist/
out/
build/
app_data/

# Electron / electron-builder local cache (if ELECTRON_CACHE is temporarily placed in project directory) [Electron / electron-builder 本地缓存 (若临时将 ELECTRON_CACHE 放到项目目录下)]
electron-cache/
.cache/
electron/
electron-builder/
winCodeSign/
nsis/
nsis-resources/
*.blockmap

# OS-generated files [操作系统生成的文件]
.DS_Store
Thumbs.db

# Editor / IDE local state [编辑器/IDE 本地状态]
.trae/
.vscode/
.idea/

# Log files [日志文件]
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log

# Environment variable files [环境变量文件]
.env
.env.local