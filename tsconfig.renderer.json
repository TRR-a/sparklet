// Renderer process TypeScript config (ESNext) [渲染进程 TypeScript 配置 (ESNext)]
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "build",
    "rootDir": ".",
    "paths": {
      "sparklet/*": ["./src/*"]
    }
  },
  "include": [
    "src/hub/core/renderer/**/*.ts",
    "src/hub/welcome/**/*.ts",
    "src/hub/main/**/*.ts",
    "src/hub/main/**/*.d.ts",
    "src/hub/core/renderer/**/*.d.ts"
  ],
  "exclude": [
    "src/hub/main/windows",
    "src/hub/main/monitor"
  ]
}
