// Renderer process TypeScript config (ESNext) [渲染进程 TypeScript 配置 (ESNext)]
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "build",
    "rootDir": "."
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.d.ts",
    "modules/**/*.ts",
    "modules/**/*.d.ts"
  ]
}
